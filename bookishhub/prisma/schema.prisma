datasource db {
  relationMode = "prisma"
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {   
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  points        Int       @default(20)
  isAdmin       Boolean   @default(false)
  password      String?
  accounts      Account[]
  sessions      Session[]                
}

model Account {   
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId], name: "account_userId")
}

model Session {   
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], name: "session_userId")             
}

model Lesson {
  id            String        @id @default(cuid())   
  lessonName     String
  picture        String
  modules        Module[]
}

model Module {
  id             String        @id @default(cuid())
  lessonId       String
  moduleName     String
  lesson         Lesson        @relation(fields: [lessonId], references: [id])
  topics         Topic[]
  @@index([lessonId], name: "lessonId")
}

model Topic {
  id             String        @id @default(cuid())
  moduleId       String
  topicName      String
  ytSearchQuery  String
  videoId        String?       
  outline        String?       @db.VarChar(4000)
  module         Module        @relation(fields: [moduleId], references: [id])
  queries        Query[]
  @@index([moduleId], name: "moduleId")
}

model Query {
  id             String        @id @default(cuid())
  topicId        String
  query          String        @db.VarChar(4000)
  solution       String        @db.VarChar(4000)
  choices        String        @db.VarChar(4000)
  topic          Topic         @relation(fields: [topicId], references: [id])
}

model Membership {
  id                           String    @id @default(cuid())
  userId                       String    @unique  
  paymentMembershipId          String?   @unique @map(name: "payment_membership_id")
  paymentCurrentPeriodEnding   DateTime? @map(name: "payment_current_period_ending")
  paymentAmmountId             String?   @map(name: "payment_ammount_id")
  paymentClientId              String    @unique @map(name: "payment_client_id")
}

model Files {
  id            Int      @id @default(autoincrement())
  pdfName       String
  pdfUrl        String
  createdAt     DateTime @default(now())
  userId        String
  fileKey       String
  summary       String
  PDFRequests   PDFRequest[] @relation("PDFRequests")
}

enum UserSystemEnum {
  SYSTEM
  USER
}

model PDFRequest {
  id                         Int      @id @default(autoincrement())
  fileId                     Int
  content                    String
  createdAt                  DateTime @default(now())
  role                       UserSystemEnum
  File                       Files    @relation("PDFRequests", fields: [fileId], references: [id])
}

model Language {
    id                         Int      @id @default(autoincrement())
    name                       String
    sessions                   LanguageSession[]
}

model LanguageSession {
  id          Int               @id @default(autoincrement())
  languageId  Int
  language    Language          @relation(fields: [languageId], references: [id])
  createdAt   DateTime          @default(now())
  level       String
  userId      String
  questions   GrammarQuestion[] 
  rephrasingQuestions RephrasingQuestion[]
}

model GrammarQuestion {
  id               String          @id @default(cuid())
  question         String          @db.VarChar(4000)
  answer           String          @db.VarChar(4000)
  choices          String          @db.VarChar(4000)
  sessionId        Int             
  session          LanguageSession @relation(fields: [sessionId], references: [id]) 
}

model RephrasingQuestion {
  id          String          @id @default(cuid())
  phrase      String          @db.VarChar(4000) 
  answer      String          @db.VarChar(4000) 
  examplePhrase String          @db.VarChar(4000) 
  exampleAnswer String          @db.VarChar(4000) 
  sessionId   Int
  session     LanguageSession @relation(fields: [sessionId], references: [id])
}

