datasource db {
  relationMode = "prisma"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {   
  uid            String        @id @default(cuid())   
  fullName       String?                              
  emailAddress   String?      @unique                 
  emailConfirmed String?                            
  profilePicture String?                              
  accountLinks   AccountInfo[]                        
  userSessions   SessionData[]
  points Int @default(5)                        
}

model AccountInfo {   
  accountId          String  @id @default(cuid())      
  accountInfoLinkedUserId       String                             
  providerService    String                             
  accountType        String                             
  accountProviderId  String                             
  refreshToken       String? @db.Text                   
  accessToken        String? @db.Text                   
  expirationTime     Int?                               
  tokenCategory      String?                            
  accessScope        String?                            
  identityToken      String? @db.Text                   
  sessionStatus      String?                            
  profile            UserProfile @relation(fields: [accountInfoLinkedUserId], references: [uid], onDelete: Cascade) 
  @@unique([providerService, accountProviderId]) 
  @@index([accountInfoLinkedUserId], name: "accountInfoLinkedUserId")       
}

model SessionData {   
  sessionId      String   @id @default(cuid())           
  token          String   @unique                       
  sessionDataLinkedUserId  String                                 
  expiryDate     String                               
  linkedProfile  UserProfile @relation(fields: [sessionDataLinkedUserId], references: [uid], onDelete: Cascade)
  @@index([sessionDataLinkedUserId], name: "sessionDataLinkedUserId")
}

model Lesson {
  uid            String        @id @default(cuid())   
  lessonName     String
  picture        String
  modules        Module[]
}

model Module {
  uid            String        @id @default(cuid())
  lessonId       String
  moduleName     String
  lesson         Lesson        @relation(fields: [lessonId], references: [uid])
  topics         Topic[]
  @@index([lessonId], name: "lessonId")
}

model Topic {
  uid            String        @id @default(cuid())
  moduleId       String
  topicName      String
  ytSearchQuery  String
  videoId        String?       
  outline        String?       @db.VarChar(4000)
  module         Module        @relation(fields: [moduleId], references: [uid])
  queries        Query[]
  @@index([moduleId], name: "moduleId")
}

model Query {
  uid            String        @id @default(cuid())
  topicId        String
  query          String        @db.VarChar(4000)
  solution       String        @db.VarChar(4000)
  choices        String        @db.VarChar(4000)
  topic          Topic         @relation(fields: [topicId], references: [uid])
}

